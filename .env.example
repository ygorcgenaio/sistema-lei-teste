# Banco MySQL
MYSQL_DATABASE=sistema_lei
MYSQL_USER=lei_user
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte

# Porta publicada localmente. No Coolify, mantenha 3000 salvo necessidade específica.
APP_PORT=3000

# Administrador inicial (criado apenas se o e-mail ainda não existir)
LEI_ADMIN_EMAIL=admin@lei.uff.br
LEI_ADMIN_PASSWORD=troque-por-uma-senha-forte
LEI_ADMIN_NAME=Administrador LEI
LEI_ADMIN_MATRICULA=
LEI_ADMIN_TELEFONE=

# Normalmente não é necessário alterar
DB_MIGRATION_MAX_ATTEMPTS=30
DB_MIGRATION_RETRY_DELAY_MS=2000

# Alternativa: caso a aplicação use um MySQL externo, DATABASE_URL também é suportada.
# Exemplo: DATABASE_URL=mysql://usuario:senha@host:3306/sistema_lei
